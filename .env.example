# ── CareerOS Runtime Configuration ──
# Copy this file to .env and adjust values for your environment.
#
#   cp .env.example .env
#
# The backend loads .env automatically on startup.

# LLM Provider  ───────────────────────────────────────────────────
# Controls which LLM backend the CV import pipeline uses.
# Supported values: ollama, openai
LLM_PROVIDER=ollama

# Ollama settings  ────────────────────────────────────────────────
# (Only required when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenAI settings  ────────────────────────────────────────────────
# (Only required when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# CV generation  ──────────────────────────────────────────────────
# When enabled, CVs generated with a job description use the LLM
# provider above to tailor content. When disabled (default), CVs
# are generated deterministically even when a job description is
# provided. Set to true to enable LLM-powered CV tailoring.
CV_LLM_ENABLED=false
