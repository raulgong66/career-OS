{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.local/schemas/publication.schema.json",
  "title": "CareerOS Publication",
  "description": "A schema for representing a publication or article within CareerOS.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/identifier",
      "description": "A stable identifier for the publication."
    },
    "title": {
      "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/label",
      "description": "The title of the publication."
    },
    "publisher": {
      "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/label",
      "description": "The publisher or publication venue."
    },
    "authors": {
      "type": "array",
      "description": "The authors of the publication.",
      "items": {
        "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/label"
      }
    },
    "publicationDate": {
      "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/date",
      "description": "The publication date."
    },
    "url": {
      "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/website",
      "description": "A public URL for the publication."
    },
    "keywords": {
      "type": "array",
      "description": "Keywords associated with the publication.",
      "items": {
        "$ref": "https://career-os.local/schemas/common.schema.json#/$defs/label"
      }
    },
    "metadata": {
      "$ref": "https://career-os.local/schemas/metadata.schema.json",
      "description": "Lifecycle and governance metadata for the publication record."
    }
  },
  "required": [
    "id",
    "title",
    "metadata"
  ]
}
